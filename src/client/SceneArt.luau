--[[
	Scene art: the illustration banner at the top of an event card, picked by the event's
	`art` scene id (pack.scenes). Drawn entirely from GUI primitives: Frames, UICorner,
	UIGradient, UIStroke and fitted TextLabels. No images.

		SceneArt.draw(parent, scene, seed?, opts?) -> Frame
			Makes a Frame that fills `parent` (Size 1,0,1,0, ClipsDescendants) holding the
			picture. Unknown scene -> "street". `seed` varies the details deterministically
			(which windows are lit, sign text, where a figure stands).
			opts.fade: Color3 for the soft fade at the bottom edge (default Theme panel ink).
		SceneArt.animate(frame) -> stop()
			Ambient motion on the parts tagged for it (a flickering sign, a blinking camera,
			a passing train, drifting dust). One Heartbeat connection at ~30 Hz; it stops by
			itself when the frame leaves the game. stop() puts everything back.
		SceneArt.scenes -> { string }   the scene ids

	Every scene is drawn on a 360 x 100 stage that keeps its shape: the stage is sized by
	the banner's height (RelativeYY) and centred, so the sides crop a little on a narrow
	phone banner (340x110) and the whole stage shows on a wide PC banner (900x260).
	Overlays (texture strips, vignette, the bottom fade) cover the whole banner.

	The geometry lives in preview/scenes.js (the browser preview draws the same scenes on a
	canvas). tools/scene_art/gen_luau.js writes it into the DATA table at the bottom of this
	file; edit the JS and regenerate. Random details resolve with the same generator in both,
	so a seed draws the same picture here and in the browser.
]]

local RunService = game:GetService("RunService")

local Theme = require(script.Parent:WaitForChild("UI"):WaitForChild("Theme"))

local SceneArt = {}

SceneArt.scenes = {
	"home", "alley", "street", "rooftop", "night", "nest", "checkpoint", "wing", "lcorp", "office", "workshop",
	"diner", "clinic", "school", "train", "syndicate", "hall", "library", "outskirts", "ruins", "market", "arena",
	"theater", "distortion", "underpass", "bus",
}

local DATA: { [string]: any }

local FONTS = {
	display = Theme.fonts.display,
	med = Theme.fonts.displayMed,
	mono = Theme.fonts.mono,
	type = Theme.fonts.type,
	ui = Theme.fonts.uiBold,
	serif = Theme.fonts.title,
}

local ALIGN = { l = Enum.TextXAlignment.Left, r = Enum.TextXAlignment.Right, c = Enum.TextXAlignment.Center }

local colorCache: { [string]: Color3 } = {}
local function hex(s: string): Color3
	local c = colorCache[s]
	if not c then
		c = Color3.fromRGB(tonumber(string.sub(s, 2, 3), 16) or 0, tonumber(string.sub(s, 4, 5), 16) or 0, tonumber(string.sub(s, 6, 7), 16) or 0)
		colorCache[s] = c
	end
	return c
end

-- ── random details (Park-Miller; preview/scenes.js uses the same numbers) ──
local MOD = 2147483647

local function hashString(s: string): number
	local h = 0
	for i = 1, #s do
		h = (h * 31 + string.byte(s, i)) % MOD
	end
	return h
end

local function newRandom(seed: number?, scene: string): () -> number
	local n = 1
	if type(seed) == "number" and seed == seed and math.abs(seed) < 2 ^ 52 then
		n = seed
	end
	local state = (math.floor(math.abs(n)) % 2147483646 * 16807 + hashString(scene) + 1) % MOD
	-- scramble, so that seeds next to each other draw very different pictures
	state = (state * 48271) % MOD
	state = bit32.bxor(state, bit32.rshift(state, 11))
	state = (state * 16807 + 12345) % MOD
	state = bit32.bxor(state, bit32.rshift(state, 7))
	state = (state * 48271) % MOD
	if state <= 0 then
		state = 1
	end
	local function nextNumber(): number
		state = (state * 48271) % MOD
		return (state - 1) / 2147483646
	end
	nextNumber()
	nextNumber()
	return nextNumber
end

-- ── building ──
-- An op is { x, y, w, h, color, key = value... } in its box's units (the stage is 360 x 100).
-- Random fields resolve in this order (preview/scenes.js does the same): x, y, w, h, rot, c, a, t.

type Ctx = {
	unit: (name: string?) -> number,
	fade: Color3?,
}

local function resolveValue(ctx: Ctx, v: any): any
	if type(v) == "table" then
		if v.R then
			return v.R[1] + ctx.unit(v.n) * (v.R[2] - v.R[1])
		elseif v.P then
			local list = v.P
			return list[math.min(#list, math.floor(ctx.unit(v.n) * #list) + 1)]
		end
	end
	return v
end

-- the sequences for each gradient in DATA, made once
local sequences: { [any]: { color: ColorSequence?, transparency: NumberSequence? } } = {}

local function gradient(g): UIGradient
	local seq = sequences[g]
	if not seq then
		seq = {}
		if g.c then
			local keys = {}
			for _, k in g.c do
				table.insert(keys, ColorSequenceKeypoint.new(k[1], hex(k[2])))
			end
			seq.color = ColorSequence.new(keys)
		end
		if g.a then
			local keys = {}
			for _, k in g.a do
				table.insert(keys, NumberSequenceKeypoint.new(k[1], 1 - k[2]))
			end
			seq.transparency = NumberSequence.new(keys)
		end
		sequences[g] = seq
	end
	local ui = Instance.new("UIGradient")
	if seq.color then
		ui.Color = seq.color
	end
	if seq.transparency then
		ui.Transparency = seq.transparency
	end
	ui.Rotation = g.r or 0
	return ui
end

local function build(ctx: Ctx, ops, parent: Instance, uw: number, uh: number)
	local z = 0
	for _, op in ops do
		if op.p ~= nil then
			-- p: chance to draw; {lo, hi}: drawn when the draw lands in that band
			local u = ctx.unit(op.pn)
			local chance = op.p
			if not (if type(chance) == "table" then u >= chance[1] and u < chance[2] else u < chance) then
				continue
			end
		end
		local v = {
			x = resolveValue(ctx, op[1]),
			y = resolveValue(ctx, op[2]),
			w = resolveValue(ctx, op[3]),
			h = resolveValue(ctx, op[4]),
		}
		v.rot = if op.rot ~= nil then resolveValue(ctx, op.rot) else nil
		v.c = if op[5] ~= nil then resolveValue(ctx, op[5]) else nil
		v.a = if op.a ~= nil then resolveValue(ctx, op.a) else nil
		v.t = if op.t ~= nil then resolveValue(ctx, op.t) else nil
		z += 1
		local isText = op.k == "T"
		local inst: GuiObject = Instance.new(if isText then "TextLabel" else "Frame") :: any
		inst.Name = op.n or (if isText then "Text" else "Shape")
		inst.BorderSizePixel = 0
		inst.ZIndex = z
		inst.AnchorPoint = Vector2.new(op.ax or 0, op.ay or 0)
		inst.Position = UDim2.fromScale(v.x / uw, v.y / uh)
		if op.yy then
			inst.SizeConstraint = Enum.SizeConstraint.RelativeYY
			inst.Size = UDim2.fromScale(v.w / uh, v.h / uh)
		else
			inst.Size = UDim2.fromScale(v.w / uw, v.h / uh)
		end
		if v.rot and v.rot ~= 0 then
			inst.Rotation = v.rot
		end
		local color = v.c
		local alpha = v.a or 1
		local fade = if op.n == "Fade" then ctx.fade else nil
		if isText then
			local label = inst :: TextLabel
			label.BackgroundTransparency = 1
			label.Text = tostring(v.t)
			label.TextScaled = true
			label.TextWrapped = true -- a multi-word sign may wrap when that lets it grow (the browser does too)
			label.FontFace = FONTS[op.f or "display"] or FONTS.display
			label.TextColor3 = hex(color)
			label.TextTransparency = 1 - alpha
			label.TextXAlignment = ALIGN[op.xa or "c"] or Enum.TextXAlignment.Center
			label.AutoLocalize = false
		elseif fade or color then
			inst.BackgroundColor3 = fade or hex(color)
			inst.BackgroundTransparency = 1 - alpha
		else
			inst.BackgroundTransparency = 1
		end
		if op.r then
			local corner = Instance.new("UICorner")
			corner.CornerRadius = UDim.new(op.r, 0)
			corner.Parent = inst
		end
		if op.g then
			gradient(op.g).Parent = inst
		end
		if op.s then
			local stroke = Instance.new("UIStroke")
			stroke.Color = hex(op.s[1])
			stroke.Transparency = 1 - op.s[2]
			stroke.Thickness = op.s[3]
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			stroke.Parent = inst
		end
		if op.clip then
			inst.ClipsDescendants = true
		end
		if op.an then
			inst:SetAttribute("Anim", op.an)
		end
		if op.o then
			local u = op.u
			build(ctx, op.o, inst, if u then u[1] else v.w, if u then u[2] else v.h)
		end
		inst.Parent = parent
	end
end

function SceneArt.draw(parent: Instance, scene: string, seed: number?, opts: { fade: Color3? }?): Frame
	local id = if DATA[scene] then scene elseif SceneArt.alias and DATA[SceneArt.alias[scene]] then SceneArt.alias[scene] else "street"
	local def = DATA[id]
	local random = newRandom(seed, id)
	local named: { [string]: number } = {}
	local ctx: Ctx = {
		unit = function(name: string?): number
			if name == nil then
				return random()
			end
			local u = named[name]
			if u == nil then
				u = random()
				named[name] = u
			end
			return u
		end,
		fade = opts and opts.fade,
	}
	local root = Instance.new("Frame")
	root.Name = "SceneArt"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundColor3 = hex(def.bg)
	root.BorderSizePixel = 0
	root.ClipsDescendants = true
	root:SetAttribute("Scene", id)
	if parent:IsA("GuiObject") then
		root.ZIndex = (parent :: GuiObject).ZIndex
	end
	build(ctx, def.o, root, 100, 100)
	root.Parent = parent
	return root
end

-- ── ambient motion ──
-- Tags (the "Anim" attribute): flicker (a failing neon tube), blink (a camera's red light),
-- pulse (a lamp breathing), sway (a hanging lamp), drift (dust in the air),
-- fall (rain: drops down and wraps), scroll:<speed> (moves sideways and wraps; speed in
-- widths of its box per second, minus for leftward).
function SceneArt.animate(frame: Frame): () -> ()
	local items = {}
	for _, d in frame:GetDescendants() do
		local tag = d:GetAttribute("Anim")
		if type(tag) == "string" and d:IsA("GuiObject") then
			local kind, arg = string.match(tag, "^(%a+):?(.*)$")
			table.insert(items, {
				inst = d,
				kind = kind or tag,
				speed = tonumber(arg) or 0,
				position = d.Position,
				rotation = d.Rotation,
				back = d.BackgroundTransparency,
				text = if d:IsA("TextLabel") then (d :: TextLabel).TextTransparency else nil,
				phase = #items * 1.73,
			})
		end
	end
	local conn: RBXScriptConnection? = nil
	local function restore()
		for _, it in items do
			local inst = it.inst
			inst.Position = it.position
			inst.Rotation = it.rotation
			inst.BackgroundTransparency = it.back
			if it.text then
				(inst :: TextLabel).TextTransparency = it.text
			end
		end
	end
	local function stop()
		if conn then
			conn:Disconnect()
			conn = nil
			if frame.Parent then
				restore()
			end
		end
	end
	if #items == 0 then
		return stop
	end
	local clock, since = 0, 0
	local function fadeTo(it, amount: number)
		-- amount 0 = as drawn, 1 = gone
		local inst = it.inst
		inst.BackgroundTransparency = it.back + (1 - it.back) * amount
		if it.text then
			(inst :: TextLabel).TextTransparency = it.text + (1 - it.text) * amount
		end
	end
	conn = RunService.Heartbeat:Connect(function(dt: number)
		if not frame.Parent then
			stop()
			return
		end
		clock += dt
		since += dt
		if since < 1 / 30 then
			return
		end
		since = 0
		for _, it in items do
			local kind = it.kind
			local p = it.position
			if kind == "flicker" then
				local n = math.noise(clock * 3.3 + it.phase, it.phase * 0.37)
				fadeTo(it, if n > 0.28 then 0.85 elseif n > 0.2 then 0.4 else 0)
			elseif kind == "blink" then
				fadeTo(it, if (clock + it.phase) % 1.6 < 0.8 then 0 else 1)
			elseif kind == "pulse" then
				fadeTo(it, 0.18 * (0.5 + 0.5 * math.sin(clock * 1.9 + it.phase)))
			elseif kind == "sway" then
				it.inst.Rotation = it.rotation + math.sin(clock * 1.2 + it.phase) * 2.5
			elseif kind == "drift" then
				it.inst.Position = p + UDim2.fromScale(math.sin(clock * 0.35 + it.phase) * 0.012, math.sin(clock * 0.5 + it.phase * 2) * 0.05)
			elseif kind == "fall" then
				local y = (p.Y.Scale + clock * 0.9 + it.phase * 0.1) % 1.3 - 0.15
				it.inst.Position = UDim2.new(p.X.Scale, p.X.Offset, y, p.Y.Offset)
			elseif kind == "scroll" then
				local x = (p.X.Scale + clock * it.speed + 0.5) % 2 - 0.5
				it.inst.Position = UDim2.new(x, p.X.Offset, p.Y.Scale, p.Y.Offset)
			end
		end
	end)
	return stop
end

