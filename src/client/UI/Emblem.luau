--[[
	Emblems: the game's small icon family (stats, currencies, clash approaches, fighting
	styles, sins, factions, tabs, misc) and the logo, drawn from GUI primitives. No images:
	rotated Frames for lines, boxes and diamonds, UICorner for circles, UIStroke for outlines
	and rings, and a UIGradient transparency step to cut a shape in half (triangles, arcs).

		Emblem.make(id, size, color?, ink?) -> Frame   size x size, transparent background
		Emblem.logo(size)                   -> Frame   a clock stopped at 3:13 in a cut diamond
		Emblem.ids                          -> { string }, every id
		Emblem.color(id)                    -> Color3, the id's default accent color

	color is the emblem's accent (defaults per id: a stat's, sin's or style's own color).
	ink is the linework; by default a pale tint of the accent. Pass the same color for both to
	get a flat single-color icon (an inactive tab), or a dark ink for a paper card:
		Emblem.make("stat.prudence", 18)                         -- on the dark HUD
		Emblem.make("stat.prudence", 18, nil, Theme.colors.ink)  -- on a paper check card
		Emblem.make("tab.store", 20, C.faint, C.faint)           -- greyed out
	An unknown id draws a neutral diamond. Build at the size you show it: line weights are
	whole pixels picked for that size (1 px up to 38 px, then about size / 26). The parts are
	placed in Scale, so a resized emblem still lines up, but its lines keep their weight.

	The geometry is generated: preview/emblems.js holds every design (the browser preview draws
	it as SVG with the same math), and `node tools/emblems/gen_luau.js` rewrites the data block
	below from it. Edit the designs there, not here. tools/emblem_sheet.html shows them all.
]]

local Kit = require(script.Parent.Kit)
local Theme = require(script.Parent.Theme)

local new = Kit.new

local Emblem = {}

type Cut = { r: number, a: number, b: number }
type Op = {
	t: string,
	-- lines
	x1: number?,
	y1: number?,
	x2: number?,
	y2: number?,
	c: number?,
	-- boxes
	x: number?,
	y: number?,
	h: number?,
	r: number?,
	s: (string | number)?,
	o: number?,
	cut: Cut?,
	-- both: w is the weight key for a line, the width for a box; i the ink
	w: any,
	i: any,
}
type Def = { c: { number }, ink: { number }?, ops: { Op } }

