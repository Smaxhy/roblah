local EPS = 0.001

local function rgb(t: { number }): Color3
	return Color3.fromRGB(t[1], t[2], t[3])
end

local function toRGB(c: Color3): { number }
	return { math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5) }
end

-- channel-wise mix rounded to whole values, like the preview's
local function mix(a: { number }, b: { number }, t: number): { number }
	local out = {}
	for j = 1, 3 do
		out[j] = math.floor(a[j] + (b[j] - a[j]) * t + 0.5)
	end
	return out
end

-- Line weights in whole pixels for an emblem of size S.
local function weights(S: number): { [string]: number }
	local n = math.max(1, math.floor(S / 26 + 0.5))
	return { n = n, b = 2 * n }
end

-- A line's center on the pixel grid: odd widths sit on pixel centers, even ones on edges.
local function snapC(v: number, t: number): number
	if t % 2 == 1 then
		return math.floor(v) + 0.5
	end
	return math.floor(v + 0.5)
end

local function snapE(v: number): number
	return math.floor(v + 0.5)
end

local function norm360(d: number): number
	return ((d % 360) + 360) % 360
end

type FrameSpec = { x: number, y: number, w: number, h: number, rot: number, round: boolean, st: number, cut: Cut? }

-- One op to the Frame that draws it, in pixels: center, size (inside any stroke), rotation,
-- corner, stroke thickness and cut. The same math as frameOf in preview/emblems.js.
local function frameOf(op: Op, S: number, W: { [string]: number }): FrameSpec
	local k = S / 24
	if op.t == "L" then
		local t = W[op.w or "n"]
		local ax, ay = snapC((op.x1 :: number) * k, t), snapC((op.y1 :: number) * k, t)
		local bx, by = snapC((op.x2 :: number) * k, t), snapC((op.y2 :: number) * k, t)
		local dx, dy = bx - ax, by - ay
		local rot = math.deg(math.atan2(dy, dx))
		if rot > 90 then
			rot -= 180
		end
		if rot <= -90 then
			rot += 180
		end
		local ext = if op.c == 0 then 0 else t -- square caps unless c = 0
		local len = math.sqrt(dx * dx + dy * dy)
		return { x = (ax + bx) / 2, y = (ay + by) / 2, w = len + ext, h = t, rot = rot, round = false, st = 0 }
	end
	local st = if op.s and op.s ~= 0 then W[op.s :: string] else 0
	local r = op.r or 0
	local x, y = op.x :: number, op.y :: number
	if r % 90 == 0 and op.o ~= 1 then
		-- axis-aligned box: snap its edges to whole pixels; a box at 90/180/270 is laid out at 0
		local swap = r % 180 ~= 0
		local w = if swap then op.h :: number else op.w :: number
		local h = if swap then op.w :: number else op.h :: number
		local x0, x1, y0, y1
		if st == 0 then
			x0 = snapE((x - w / 2) * k)
			x1 = math.max(snapE((x + w / 2) * k), x0 + 1)
			y0 = snapE((y - h / 2) * k)
			y1 = math.max(snapE((y + h / 2) * k), y0 + 1)
		else
			-- an outline's centerline sits on the box's edge; the Frame is inside it
			x0 = snapC((x - w / 2) * k, st) + st / 2
			x1 = math.max(snapC((x + w / 2) * k, st) - st / 2, x0)
			y0 = snapC((y - h / 2) * k, st) + st / 2
			y1 = math.max(snapC((y + h / 2) * k, st) - st / 2, y0)
		end
		local cut = op.cut
		if cut and r ~= 0 then
			cut = { r = norm360(cut.r + r), a = cut.a, b = cut.b }
		end
		return { x = (x0 + x1) / 2, y = (y0 + y1) / 2, w = x1 - x0, h = y1 - y0, rot = 0, round = false, st = st, cut = cut }
	end
	return {
		x = x * k,
		y = y * k,
		w = math.max(0, (op.w :: number) * k - st),
		h = math.max(0, (op.h :: number) * k - st),
		rot = r,
		round = op.o == 1,
		st = st,
		cut = op.cut,
	}
end

-- The UIGradient step that keeps gradient positions a..b (everything else fully transparent).
local function cutSequence(a: number, b: number): NumberSequence
	local keys = {}
	if a > 0 then
		table.insert(keys, NumberSequenceKeypoint.new(0, 1))
		table.insert(keys, NumberSequenceKeypoint.new(a - EPS, 1))
		table.insert(keys, NumberSequenceKeypoint.new(a, 0))
	else
		table.insert(keys, NumberSequenceKeypoint.new(0, 0))
	end
	if b < 1 then
		table.insert(keys, NumberSequenceKeypoint.new(b, 0))
		table.insert(keys, NumberSequenceKeypoint.new(b + EPS, 1))
		table.insert(keys, NumberSequenceKeypoint.new(1, 1))
	else
		table.insert(keys, NumberSequenceKeypoint.new(1, 0))
	end
	return NumberSequence.new(keys)
end

type Ink = { color: Color3, alpha: number }

local function inksOf(accent: { number }, line: { number }): { [string]: Ink }
	return {
		l = { color = rgb(line), alpha = 1 },
		m = { color = rgb(line), alpha = 0.5 },
		a = { color = rgb(accent), alpha = 1 },
		d = { color = rgb(accent), alpha = 0.35 },
		h = { color = rgb(mix(accent, { 255, 255, 255 }, 0.5)), alpha = 1 },
		k = { color = rgb(DARK), alpha = 1 },
	}
end

local function inkOf(i: any, inks: { [string]: Ink }): Ink
	if type(i) == "table" then
		return { color = rgb(i), alpha = 1 }
	end
	return inks[i] or inks.l
end

-- Parts are placed in Scale: UDim offsets are whole pixels in Roblox, and the geometry needs
-- half pixels (a 1 px line centered on a pixel) and fractional lengths (diagonals).
local function part(fr: FrameSpec, S: number, ink: Ink, z: number, name: string): Frame
	local frame = new("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(fr.x / S, fr.y / S),
		Size = UDim2.fromScale(fr.w / S, fr.h / S),
		Rotation = fr.rot,
		BorderSizePixel = 0,
		BackgroundColor3 = ink.color,
		BackgroundTransparency = if fr.st == 0 then 1 - ink.alpha else 1,
		ZIndex = z,
	}) :: Frame
	-- a fill's cut goes on the Frame, an outline's on its UIStroke
	local cutHolder: Instance = frame
	if fr.st > 0 then
		cutHolder = new("UIStroke", {
			Thickness = fr.st,
			Color = ink.color,
			Transparency = 1 - ink.alpha,
			LineJoinMode = Enum.LineJoinMode.Miter,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Parent = frame,
		})
	end
	if fr.round then
		new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = frame })
	end
	local cut = fr.cut
	if cut then
		new("UIGradient", { Rotation = cut.r, Transparency = cutSequence(cut.a, cut.b), Parent = cutHolder })
	end
	return frame
end

local function render(def: Def, size: number, inks: { [string]: Ink }, name: string): Frame
	local S = math.max(1, math.floor(size + 0.5))
	local W = weights(S)
	local root = new("Frame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromOffset(S, S),
	}) :: Frame
	for n, op in def.ops do
		part(frameOf(op, S, W), S, inkOf(op.i, inks), n, string.format("%s%02d", op.t, n)).Parent = root
	end
	return root
end

Emblem.ids = table.clone(ORDER)

-- "wing:K" draws K on a Wing's hexagon; "assoc:2" draws 2 on an Association's shield
local function badge(kind: string, mark: string, size: number, color: Color3?): Frame?
	local def = DEFS["badge." .. kind]
	if not def then
		return nil
	end
	local accent = if color then toRGB(color) else def.c
	local line = mix(accent, BONE, INK_MIX)
	local frame = render(def, size, inksOf(accent, line), "Emblem")
	new("TextLabel", {
		Name = "Mark",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, if kind == "assoc" then 0.43 else 0.5),
		Size = UDim2.fromScale(0.62, if #mark > 1 then 0.4 else 0.52),
		Text = mark,
		FontFace = Theme.fonts.display,
		TextScaled = true,
		TextColor3 = rgb(accent),
		ZIndex = 4,
		Parent = frame,
	})
	frame:SetAttribute("EmblemId", kind .. ":" .. mark)
	return frame
end

function Emblem.make(id: string, size: number, color: Color3?, ink: Color3?): Frame
	local kind, mark = string.match(id, "^(%a+):(.+)$")
	if kind and mark then
		local b = badge(kind, mark, size, color)
		if b then
			return b
		end
	end
	local def = DEFS[id] or FALLBACK
	local accent = if color then toRGB(color) else def.c
	local line
	if ink then
		line = toRGB(ink)
	elseif color == nil and def.ink then
		line = def.ink
	else
		line = mix(accent, BONE, INK_MIX)
	end
	local frame = render(def, size, inksOf(accent, line), "Emblem")
	frame:SetAttribute("EmblemId", id)
	return frame
end

function Emblem.logo(size: number): Frame
	return render(LOGO, size, inksOf(LOGO.c, BONE), "Logo")
end

function Emblem.color(id: string): Color3
	local kind = string.match(id, "^(%a+):")
	if kind and DEFS["badge." .. kind] then
		return rgb(DEFS["badge." .. kind].c)
	end
	return rgb((DEFS[id] or FALLBACK).c)
end

return Emblem
