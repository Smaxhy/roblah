--[[
	Recruitment (writer: fc_ ids). Factions come looking for you because of who you are:
	stats, traits, style, deeds (flags), your District and the era. Accepting usually joins
	the career (`career`), often with a signing bonus, gear or a book. Some factions don't
	take no well: refusals schedule consequences (weight-0 follow-ups below). Also here:
	rival offers, poaching from your current job, and loyalty tests inside a faction.
	Canon: docs/CANON.md sections 3, 4, 7.1 and 8. Offices, NPCs and incidents are this
	game's own. Guidebook entries for every faction: Factions.luau.
]]

-- every career id (and "none"), so offers can skip people already in that career
local ALL = {
	"none", "workshop", "diner", "academy", "courier", "clinic", "nest_clerk", "landlord",
	"wing", "lcorp_agent", "lcorp_research", "kcorp", "wcorp_cleanup", "rcorp", "wg_tcorp", "wg_hcorp",
	"fixer", "zwei", "liu", "seven", "devyat", "shi", "cinq", "dieci", "oufi", "hana",
	"thumb", "middle", "index", "ring", "kurokumo",
	"limbus_lccb", "limbus_lce", "lim_lcd", "bf_family",
}
local function except(...)
	local skip = {}
	for _, id in { ... } do
		skip[id] = true
	end
	local out = {}
	for _, id in ALL do
		if not skip[id] then
			table.insert(out, id)
		end
	end
	return out
end

