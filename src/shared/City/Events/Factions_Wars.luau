--[[
	Faction wars (writer: fc_ ids). World events: WorldEvents/Factions.luau.
	Each war: a start event everyone old enough sees (pick a side, profiteer, or hide). It also
	rolls while the war is on, for anyone who missed it (cooldown 6, so once per war);
	picking a side triggers that side's battle scene at once (reached only from the war's own
	card, so it isn't war-gated itself) and schedules an aftermath a
	year later. Random war scenes roll while the war is on (when.worldEvent, tagged and
	boosted by the world event's tagWeights). Who wins depends on the District you live in
	when the aftermath comes: the lists below. The winning side pays big (Ahn, a trait, a
	unique war spoil for those who won their battle, sometimes a place in the faction); the
	losing side pays the winners. Hana's crackdown has no sides and no aftermath.
	Canon: docs/CANON.md sections 3, 4, 8.3 and the Bloodfiend notes in Events/Bloodfiend.luau.
	The incidents, Families and people here are this game's own.
]]

local ERAS = { "wings", "library", "limbus" }

-- every Association career but one (for "join us" offers)
local ASSOCIATIONS = { "zwei", "liu", "seven", "devyat", "shi", "cinq", "dieci", "oufi", "hana" }
local function notIn(id)
	local out = { "none", "workshop", "diner", "academy", "courier", "clinic", "nest_clerk", "landlord", "fixer",
		"wing", "lcorp_agent", "lcorp_research", "kcorp", "wcorp_cleanup", "rcorp", "wg_tcorp", "wg_hcorp",
		"thumb", "middle", "index", "ring", "kurokumo", "limbus_lccb", "limbus_lce", "lim_lcd", "bf_family" }
	for _, a in ASSOCIATIONS do
		if a ~= id then
			table.insert(out, a)
		end
	end
	return out
end

