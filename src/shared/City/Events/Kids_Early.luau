--[[
	Early childhood, part one (ke_): ages 1-3. Short, sensory and family-sized. Toddler
	choices (babble, grab, hide, stay very still) with small stakes: a point of Sanity, a point
	of a virtue, a flag that shapes later years. Ages 4-6, and the follow-ups that pay these
	flags off at ages 7-12, are in Kids_Early2.luau. Faces: Cast/Kids_Early.luau.
	Chains started here (follow-ups in Kids_Early2.luau):
		ke_t_redfoot      -> ke_f_redfoot       the pigeon keeper on the roof, ~7
		ke_n_camera       -> ke_f_nest_file     the academy interview, ~8
		ke_n_grandmother  -> ke_f_grandma_pass  the visitor pass, ~7
		ke_t_cot_friend   -> ke_f_ivo           visiting day at the foundling house, ~7
		ke_t_two_names    -> ke_f_real_name     the home name called in the market, ~8
	Flags read again at 4-6: ke_saw_coat, ke_hush, ke_brown_shoes, ke_saw_cleanup, ke_wants_red.
]]

-- scenes set in a family flat (a landing, neighbors, the front door)
local NO_HOME = { "foundling", "bf_family_raised" }

-- the only clash at these ages: a toddler's check (spec: ages 1-5)
local function kid(stat: string, foe: string)
	return { stat = stat, foe = foe, coins = 1, base = 1, coinPower = 2, fixed = true }
end

